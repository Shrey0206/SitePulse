# Production (Railway): set NODE_ENV=production explicitly -- it is what marks the refresh
# cookie Secure. DATABASE_URL, JWT_SECRET and WEBHOOK_SECRET_KEY below must also be set as
# service variables; PORT is injected by Railway.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://sitepulse:sitepulse@localhost:5432/sitepulse
JWT_SECRET=change-me-to-a-long-random-value
BCRYPT_ROUNDS=12

# SMTP (Nodemailer). Defaults target the mailpit container in docker-compose.
# NOTE: Railway blocks outbound SMTP on Free/Trial/Hobby plans, so email alerts cannot send
# there (webhooks still work). Elsewhere, point these at a real relay: port 587 works as-is
# (STARTTLS); for implicit TLS on port 465 also set SMTP_SECURE=true.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@sitepulse.local

# AES-256-GCM key for webhook HMAC secrets at rest: 32 bytes, hex-encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET_KEY=
